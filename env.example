# Copy to .env.local for local work. In Vercel: Project Settings > Environment Variables.
# Safe in the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # "anon" or "publishable" key
NEXT_PUBLIC_SITE_URL=               # e.g. https://your-app.vercel.app

# SERVER ONLY. Never commit, never put in front-end code:
SUPABASE_SERVICE_ROLE_KEY=          # "service_role" or "secret" key
